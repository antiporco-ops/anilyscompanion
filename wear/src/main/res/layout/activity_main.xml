<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="192dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/wear_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phone_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/phone_battery_label"
            android:textColor="@color/wear_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/phone_battery_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/phone_battery_unknown_value"
            android:textColor="@color/wear_text_primary"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phone_battery_charge_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/phone_battery_no_data"
            android:textColor="@color/wear_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/phone_battery_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/wear_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="128dp"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/wear_button_background"
            android:gravity="center"
            android:minHeight="44dp"
            android:minWidth="96dp"
            android:text="@string/phone_battery_refresh"
            android:textAllCaps="false"
            android:textColor="@color/wear_button_text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
