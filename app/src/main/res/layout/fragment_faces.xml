<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/catalog_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/watchface_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <TextView
                android:id="@+id/footer_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/footer_note"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/fixed_hero_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp"
        android:translationZ="0dp">

        <include
            android:id="@+id/top_brand_header"
            layout="@layout/include_top_brand_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="@dimen/faces_hero_card_bottom_padding">

                <ImageView
                    android:id="@+id/image_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/selected_preview_cd"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_placeholder"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toStartOf="@id/selected_title"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_weight="1.10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/faces_hero_image_max_width"
                    app:layout_constraintWidth_min="@dimen/faces_hero_image_min_width" />

                <TextView
                    android:id="@+id/selected_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/selected_default"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/watch_status"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/image_view"
                    app:layout_constraintTop_toTopOf="@id/image_view"
                    app:layout_constraintVertical_bias="0.50"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/watch_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/status_placeholder"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toTopOf="@id/btn_install_on_watch"
                    app:layout_constraintEnd_toEndOf="@id/selected_title"
                    app:layout_constraintStart_toEndOf="@id/image_view"
                    app:layout_constraintTop_toBottomOf="@id/selected_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_install_on_watch"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/cta_install_on_watch"
                    android:textSize="12sp"
                    app:cornerRadius="15dp"
                    app:icon="@drawable/watch_on"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:layout_constraintBottom_toTopOf="@id/btn_learn_more"
                    app:layout_constraintEnd_toEndOf="@id/selected_title"
                    app:layout_constraintStart_toStartOf="@id/selected_title"
                    app:layout_constraintTop_toBottomOf="@id/watch_status"
                    app:layout_goneMarginTop="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_learn_more"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:minWidth="@dimen/a11y_min_touch_target"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/cta_learn_more"
                    android:textSize="11sp"
                    app:cornerRadius="9dp"
                    app:iconPadding="0dp"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/image_view"
                    app:layout_constraintEnd_toEndOf="@id/btn_install_on_watch"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="@id/btn_install_on_watch"
                    app:layout_constraintTop_toBottomOf="@id/btn_install_on_watch" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/hero_bottom_fade"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="0dp"
            android:translationY="0dp"
            android:background="@drawable/faces_hero_bottom_fade"
            android:importantForAccessibility="no" />
    </LinearLayout>

</FrameLayout>
