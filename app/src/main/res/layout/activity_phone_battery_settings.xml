<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/phone_battery_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_battery_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phone_battery_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/phone_battery_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/phone_battery_sync_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/phone_battery_sync_disclaimer"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_phone_battery_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/phone_battery_switch_label"
            android:textColor="?attr/colorOnSurface"
            app:switchPadding="12dp" />

        <TextView
            android:id="@+id/phone_battery_switch_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/phone_battery_switch_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/phone_battery_auto_refresh_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/phone_battery_auto_refresh_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phone_battery_auto_refresh_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/phone_battery_auto_refresh_description"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/radio_group_phone_battery_auto_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_phone_battery_auto_refresh_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_battery_auto_refresh_5_min"
                android:textColor="?attr/colorOnSurface"
                app:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/radio_phone_battery_auto_refresh_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_battery_auto_refresh_10_min"
                android:textColor="?attr/colorOnSurface"
                app:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/radio_phone_battery_auto_refresh_15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_battery_auto_refresh_15_min"
                android:textColor="?attr/colorOnSurface"
                app:buttonTint="?attr/colorPrimary" />
        </RadioGroup>

        <TextView
            android:id="@+id/phone_battery_auto_refresh_hint_fast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/phone_battery_auto_refresh_hint_fast"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/phone_battery_auto_refresh_hint_slow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/phone_battery_auto_refresh_hint_slow"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_anilys_wear_on_watch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/phone_battery_install_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_phone_battery"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/phone_battery_on_watch_back_button" />

    </LinearLayout>
</ScrollView>
